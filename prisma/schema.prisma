// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ContestStatus {
  UPCOMING
  LIVE
  ENDED
}

model Users {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @db.VarChar(191)
  email          String            @unique
  image          Json?
  role           UserRole          @default(USER)
  password       String
  LoginType      String            @default("email")
  refreshToken   String            @default("")
  otp            String            @default("")
  isVerified     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  problems       Problems[]
  submissions    Submissions[]
  solvedProblems ProblemSolved[]
  playlist       Playlist[]
  userActivity   UserActivity[]
  comunity       Comunity[]
  Commentby      ComunityComment[]
  upvote         ComunityUpvote[]
  contests       Contest[]

  @@index([email])
}

model Problems {
  id                 String            @id @default(uuid()) @db.Uuid
  title              String            @db.VarChar(191)
  description        String
  tags               String[]
  difficulty         ProblemDifficulty @default(EASY)
  userId             String            @db.Uuid
  example            Json
  constraints        String
  hints              String?
  editorial          String?
  testCases          Json
  codeSnippet        Json
  isContestProblem   Boolean           @default(false)
  referenceSolutions Json
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  activity           UserActivity[]

  //RELATIONSHIPS
  user             Users               @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions      Submissions[]
  solvedBy         ProblemSolved[]
  problemPlaylists problemInPlaylist[]
}

model Submissions {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  problemId     String   @db.Uuid
  sourceCode    Json
  language      String
  stdin         String?
  stdout        String?
  stderr        String?
  compileOutput String?
  status        String
  memory        String?
  time          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  //RELATIONSHIPS
  user      Users       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problems    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  testCases TestCases[]
}

model TestCases {
  id             String   @id @default(uuid()) @db.Uuid
  submissionId   String   @db.Uuid
  testCase       Int
  passed         Boolean
  stdout         String?
  expectedOutput String?
  stderr         String?
  status         String
  memory         String?
  time           String?
  compileOutput  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  //RELATIONSHIPS
  submission Submissions @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model ProblemSolved {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  problemId    String         @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userActivity UserActivity[]
  //RELATIONSHIPS
  user         Users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem      Problems       @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model Playlist {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  description String?
  userId      String              @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  problems    problemInPlaylist[]
  user        Users               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId])
}

model problemInPlaylist {
  id         String   @id @default(uuid()) @db.Uuid
  problemId  String   @db.Uuid
  playlistId String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  //RELATIONSHIPS
  problem  Problems @relation(fields: [problemId], references: [id], onDelete: Cascade)
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([problemId, playlistId])
}

model UserActivity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  problemId       String   @db.Uuid
  problemSolvedId String?  @db.Uuid
  streakCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  //RELATIONSHIPS
  user          Users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem       Problems       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemSolved ProblemSolved? @relation(fields: [problemSolvedId], references: [id], onDelete: SetNull)

  @@unique([userId, problemId]) // Changed from just [userId] to allow multiple activities per user
}

model Comunity {
  id        String            @id @default(uuid()) @db.Uuid
  title     String
  content   String
  userId    String            @db.Uuid
  tags      String[]
  image     String?
  view      Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  upvotes   ComunityUpvote[]
  comments  ComunityComment[]
  user      Users             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ComunityComment {
  id         String   @id @default(uuid()) @db.Uuid
  comunityId String   @db.Uuid
  userId     String   @db.Uuid
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  //RELATIONSHIPS
  comunity Comunity @relation(fields: [comunityId], references: [id], onDelete: Cascade)
  user     Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ComunityUpvote {
  id         String   @id @default(uuid()) @db.Uuid
  comunityId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())
  isVote     Boolean
  updatedAt  DateTime @updatedAt
  //RELATIONSHIPS
  comunity   Comunity @relation(fields: [comunityId], references: [id], onDelete: Cascade)
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([comunityId, userId])
}

model Contest {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  problemIds   String[]      @db.Uuid
  startTime    String
  endTime      String
  status       ContestStatus @default(UPCOMING)
  duration     Int           @default(90)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  participants Users[]
}

model Score {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  contestId String   @db.Uuid
  score     Int      @default(0)
  timeTaken DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contestId]) // Ensure unique score per user in a contest
}
